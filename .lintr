linters: rapwhale::rapwhale_linters()
exclusions: list(
    "tests/testthat/rapwhale-style",
    "R/fixme_stil_linter.R" = list(
        fixme_stil_linter = Inf
    ),
    "tests/testthat/test-fixme_stil_linter.R" = list(
        fixme_stil_linter = Inf
    ),
    "tests/testthat.R" = list(
        undesirable_function_linter = Inf,
        unused_import_linter = Inf
    )
  )
